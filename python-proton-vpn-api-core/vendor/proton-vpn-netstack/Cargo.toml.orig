[package]
name = "proton-vpn-netstack"
version = "0.6.5"
edition = "2024"

[features]
default = ["rng"]
std = ["smoltcp/std", "proton-os-interface/std"]
async = ["dep:futures"]
rng = ["dep:rand_xoshiro"]
tcp-cubic = ["smoltcp/socket-tcp-cubic"]

[dependencies]
futures = {version = "0.3", optional = true}
smoltcp = { version = "0.12", default-features = false, features = ["async", "log", "verbose", "medium-ip", "proto-ipv4", "proto-ipv6", "socket-tcp", "socket-udp", "alloc", "socket-tcp-reno"] }
derive_more = { version = "2", features = ["full"] }
tracing = { version = "0.1", features = ["log"] }
thiserror = { version = "2", default-features = false }
rand_xoshiro = {version = "0.7", optional = true}

[dependencies.proton-os-interface]
registry = "proton"
version = "0.2"

[dev-dependencies]
proton-vpn-netstack = {path = ".", features = ["async", "std", "rng"]}
env_logger = "0.11"
tokio = { version = "1", features = ["full", "test-util"] }
etherparse = { version = "0.18"}
x25519-dalek = {version = "2.0.0-pre.1" }
rand = { version = "0.9" }
anyhow = "1.0.98"
