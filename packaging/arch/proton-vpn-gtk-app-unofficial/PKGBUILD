# Maintainer: libertypo <libertypo at proton dot me>
pkgname=proton-vpn-gtk-app-community
pkgver=1.0.0
pkgrel=1
pkgdesc="Community Proton VPN GTK client with ProTun support"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'networkmanager' 'python-dbus' 'python-requests' 'python-packaging' 'python-distro' 'python-proton-core' 'python-proton-vpn-api-core-local' 'python-proton-vpn-local-agent' 'proton-vpn-daemon' 'python-cryptography' 'python-fido2' 'python-pynacl' 'python-jinja' 'python-sentry_sdk' 'libnotify')
provides=('proton-vpn-gtk-app' 'protonvpn')
conflicts=('proton-vpn-gtk-app' 'proton-vpn-gtk-app-git' 'proton-vpn-gtk-app-unofficial' 'proton-vpn-gtk-app-unofficial-bin' 'proton-vpn-gtk-app-unofficial-git' 'protonvpn' 'protonvpn-gui')
install="proton-vpn-gtk-app-unofficial.install"
source=("https://github.com/libertypo/proton-vpn-unofficial-/archive/refs/tags/v${pkgver}.tar.gz"
        "proton-vpn-gtk-app-unofficial.desktop")
sha256sums=(
  '979886fadb79587cc9231eb9e24e2f12b51c2c6fa4f446fe30ffdd1f7dc0be73'
  'bf2cd0f8be5d2317c14a518d190657a757dba58159290c6e89d021a8650ec3a6'
)

package() {
  local site_packages
  site_packages="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
  install -d "${pkgdir}${site_packages}/proton/vpn"
  cp -a "${srcdir}/proton-vpn-unofficial--${pkgver}/proton/vpn/app" "${pkgdir}${site_packages}/proton/vpn/"
  install -Dm644 "${srcdir}/proton-vpn-unofficial--${pkgver}/versions.yml" "${pkgdir}/usr/share/${pkgname}/versions.yml"
  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${pkgname}" <<'EOF'
#!/usr/bin/env bash
exec python3 -m proton.vpn.app.gtk "$@"
EOF
  ln -s "${pkgname}" "${pkgdir}/usr/bin/protonvpn-app-community"
  install -Dm644 "${srcdir}/proton-vpn-gtk-app-unofficial.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
}
