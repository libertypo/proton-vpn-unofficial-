# Maintainer: libertypo <libertypo at proton dot me>
pkgname=python-proton-vpn-api-core-local
pkgver=5.5.11
pkgrel=1
pkgdesc="Proton VPN API core with NetworkManager ProTun support"
arch=('x86_64')
license=('GPL-3.0-or-later')
options=('!lto')
provides=('python-proton-vpn-api-core=5.5.11')
conflicts=('python-proton-vpn-api-core' 'python-proton-vpn-network-manager' 'nm-protun-artifacts-unofficial')
depends=('python' 'python-proton-core' 'python-proton-vpn-local-agent' 'python-cryptography' 'python-distro' 'python-jinja' 'python-pynacl' 'python-packaging' 'python-sentry_sdk' 'python-fido2' 'python-gobject' 'python-cairo' 'networkmanager' 'dbus')
makedepends=('cargo' 'rust' 'python-setuptools')
source=("https://github.com/libertypo/proton-vpn-unofficial-/archive/refs/tags/v1.0.0.tar.gz"
        'nm-protun.service')
sha256sums=('979886fadb79587cc9231eb9e24e2f12b51c2c6fa4f446fe30ffdd1f7dc0be73'
      '900df4fee83a824ad620591f5cb2e8759fc3d855bacb688a466f731df23ced50')

build() {
  cd "${srcdir}/proton-vpn-unofficial--1.0.0/python-proton-vpn-api-core"
  export CARGO_REGISTRIES_PROTON_INDEX='sparse+https://rust-registry.proton.me/index/'
  export CARGO_REGISTRIES_PROTON_PUBLIC_INDEX='sparse+https://rust-registry.proton.me/index/'
  cargo build --locked --release --features 'protun nm_protun_auth_dialog'
}

package() {
  local site_packages
  site_packages="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
  cd "${srcdir}/proton-vpn-unofficial--1.0.0/python-proton-vpn-api-core"
  python setup.py install --root="$pkgdir" --optimize=1
  find "$pkgdir" -type d -name __pycache__ -prune -exec rm -rf {} +
  find "$pkgdir" -type f -name '*.pyc' -delete
  install -Dm755 target/release/nm-protun-service "$pkgdir/usr/libexec/nm-protun-service"
  install -Dm755 target/release/nm-protun-auth-dialog "$pkgdir/usr/libexec/nm-protun-auth-dialog"
  install -Dm644 resources/nm-protun.name "$pkgdir/usr/lib/NetworkManager/VPN/nm-protun.name"
  install -Dm644 resources/nm-protun-service.conf "$pkgdir/usr/share/dbus-1/system.d/nm-protun-service.conf"
  install -Dm644 "${srcdir}/nm-protun.service" "$pkgdir/usr/lib/systemd/system/nm-protun.service"
  sed -i 's|^program=.*|program=/usr/libexec/nm-protun-service|' "$pkgdir/usr/lib/NetworkManager/VPN/nm-protun.name"
  sed -i 's|^auth-dialog=.*|auth-dialog=/usr/libexec/nm-protun-auth-dialog|' "$pkgdir/usr/lib/NetworkManager/VPN/nm-protun.name"
}
